# Preencha apenas o provedor que for usar.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=          # gratuito em https://aistudio.google.com/apikey

# Opcional: trocar o modelo padrão
# ANTHROPIC_MODEL=claude-sonnet-5-5
# GEMINI_MODEL=gemini-flash-lite-latest   # ou gemini-flash-latest (mais forte, mas às vezes sobrecarregado)
# OPENAI_MODEL=gpt-4.1-mini

# Opcional: qualquer endpoint compatível com OpenAI (Groq, OpenRouter, Ollama...)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
